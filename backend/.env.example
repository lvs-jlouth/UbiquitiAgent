# Application
APP_NAME=UniFi AI Operations Assistant
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ubiquitiagent

# Security (CHANGE THESE IN PRODUCTION)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# UniFi
UNIFI_HOST=
UNIFI_PORT=443
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false

# Operating Mode: read_only, approval_required, authorized_change
OPERATING_MODE=read_only

# Scheduler
TELEMETRY_INTERVAL_SECONDS=60

# Agent rate limiting
AGENT_RATE_LIMIT_PER_MINUTE=10
